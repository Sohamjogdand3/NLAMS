PROJECT_NAME="NLAMS API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Redis
REDIS_URL=redis://localhost:6379/0

# Email Service (ethereal, mailtrap, smtp, console)
EMAIL_PROVIDER=ethereal
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@nlams.gov.demo
SMTP_FROM_NAME="NLAMS Identity System"

# Database Configuration
POSTGRES_USER=nlams_user
POSTGRES_PASSWORD=nlams_pass
POSTGRES_DB=nlams_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://nlams_user:nlams_pass@db:5432/nlams_dev

